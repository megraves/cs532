FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir fastapi uvicorn python-multipart httpx

RUN mkdir -p /app/api

COPY api/ /app/api/

ENV PYTHONPATH=/app
EXPOSE 8002

CMD ["python", "api/coordinator_api.py"]
